<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <!-- Background rounded soft blush base -->
  <rect width="64" height="64" rx="18" fill="#F99B8D"/>
  
  <!-- Subtle inner background glow -->
  <rect x="2" y="2" width="60" height="60" rx="16" stroke="#FFFFFF" stroke-width="1.5" stroke-opacity="0.3"/>
  
  <!-- Rosette Geometric Icon in Center -->
  <g transform="translate(32, 32)">
    <!-- 8 Petals -->
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(0)"/>
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(22.5)"/>
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(45)"/>
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(67.5)"/>
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(90)"/>
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(112.5)"/>
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(135)"/>
    <ellipse cx="0" cy="0" rx="4.5" ry="16" stroke="#221F1E" stroke-width="1.2" stroke-opacity="0.85" transform="rotate(157.5)"/>
    
    <!-- Central Core -->
    <circle cx="0" cy="0" r="4.5" fill="#FBEFE9" stroke="#221F1E" stroke-width="1.2"/>
    <circle cx="0" cy="0" r="1.8" fill="#221F1E"/>
  </g>
</svg>
